# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.next-check/

# file unggahan lokal
/storage/

# dokumen internal (proposal) tidak dipublikasikan
/docs/*.pdf
/.next-build/
/.next.prev/
/.deploy.env
/.next-turbo/
docs/API-Integrasi-sadc.md
docs/Tanggapan-API-Integrasi-sadc.md
